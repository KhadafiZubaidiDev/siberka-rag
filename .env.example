# ── Google Cloud ──────────────────────────────────────────────────
# Ganti dengan Google Cloud Project ID Anda
GOOGLE_CLOUD_PROJECT=your-project-id

# Region Vertex AI (rekomendasi: us-central1 atau asia-southeast1)
GOOGLE_CLOUD_REGION=us-central1

# ── Model Configuration ───────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=siberka_docs

# ── RAG Parameters ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# ── App ───────────────────────────────────────────────────────────
APP_TITLE=SiberkaRAG

# ── Auth & User Management ────────────────────────────────────────
# Path database SQLite
DB_PATH=./data/siberka.db

# Username admin default (dibuat otomatis saat pertama kali run)
ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234

# Kuota default dokumen per user baru
DEFAULT_DOC_QUOTA=20

# Izinkan user daftar sendiri? (true/false)
# Jika false, hanya admin yang bisa membuat akun
ALLOW_REGISTER=false
